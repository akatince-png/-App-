# Supabase Projekt-Zugangsdaten (zu finden unter Project Settings -> API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# KI-Coach — Provider per ENV wählbar (siehe src/services/aiProviders.js).
# "ollama" für lokale Entwicklung, "groq" oder "gemini" für Cloud-Betrieb.
VITE_AI_PROVIDER=ollama
VITE_AI_MODEL=llama3.1
# Nur nötig, wenn abweichend vom Standard-Endpunkt des gewählten Providers
# (z. B. Ollama läuft auf einem anderen Rechner/Port als localhost:11434).
# VITE_AI_BASE_URL=http://localhost:11434
# Nur für Gemini nötig, und für Groq als schneller (aber unsicherer) Testweg
# — der Key landet dann sichtbar im ausgelieferten Browser-Code. Bei Ollama
# niemals einen echten Key eintragen.
# VITE_AI_API_KEY=
#
# Groq im sicheren Normalbetrieb (empfohlen): VITE_AI_API_KEY HIER NICHT
# setzen. Stattdessen den echten Groq-Key als Secret bei der Supabase
# Edge Function hinterlegen (Supabase Dashboard -> Edge Functions ->
# groq-chat -> Secrets, NICHT hier und NICHT als Vercel-Variable):
#   GROQ_API_KEY=dein-echter-groq-key
