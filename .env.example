# Supabase Projekt-Zugangsdaten (zu finden unter Project Settings -> API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# KI-Coach — Provider per ENV wählbar (siehe src/services/aiProviders.js).
# "ollama" für lokale Entwicklung, "groq" oder "gemini" für Cloud-Betrieb.
VITE_AI_PROVIDER=ollama
VITE_AI_MODEL=llama3.1
# Nur nötig, wenn abweichend vom Standard-Endpunkt des gewählten Providers
# (z. B. Ollama läuft auf einem anderen Rechner/Port als localhost:11434).
# VITE_AI_BASE_URL=http://localhost:11434
# Als schneller (aber unsicherer) Testweg für Groq/Gemini nutzbar — der Key
# landet dann sichtbar im ausgelieferten Browser-Code. Bei Ollama niemals
# einen echten Key eintragen.
# VITE_AI_API_KEY=
#
# Groq/Gemini im sicheren Normalbetrieb (empfohlen): VITE_AI_API_KEY HIER
# NICHT setzen. Stattdessen den echten Key als Secret bei der passenden
# Supabase Edge Function hinterlegen (Supabase Dashboard -> Edge Functions
# -> groq-chat bzw. gemini-chat -> Secrets, NICHT hier und NICHT als
# Vercel-Variable):
#   GROQ_API_KEY=dein-echter-groq-key
#   GEMINI_API_KEY=dein-echter-gemini-key

# Spotify-Anbindung ("Aka startet meine Musik") — Client-ID aus dem
# Spotify-Entwickler-Dashboard (developer.spotify.com/dashboard), NICHT
# geheim, darf hier + als Vercel-Variable stehen. Das zugehörige
# Client-Secret dagegen NIE hier eintragen, sondern nur als Secret bei den
# Edge Functions spotify-auth-callback und spotify-play (Supabase Dashboard
# -> Edge Functions -> Secrets):
#   SPOTIFY_CLIENT_ID=dieselbe-id-wie-unten
#   SPOTIFY_CLIENT_SECRET=dein-echtes-secret
VITE_SPOTIFY_CLIENT_ID=deine-spotify-client-id

# Cloud-Sprachausgabe (Google Cloud Text-to-Speech, WaveNet-Stimme statt der
# robotischen Browser-Stimme) — NIE hier oder als Vercel-Variable, nur als
# Secret bei der Edge Function text-to-speech (Supabase Dashboard ->
# Edge Functions -> text-to-speech -> Secrets):
#   GOOGLE_TTS_API_KEY=dein-echter-google-cloud-api-key
